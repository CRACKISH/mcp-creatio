{
	"name": "mcp-creatio",
	"version": "0.8.0",
	"main": "dist/index.js",
	"bin": {
		"mcp-creatio": "dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"clean": "rimraf ./dist",
		"prebuild": "npm run clean",
		"build": "tsc",
		"start": "ts-node src/index.ts",
		"start:cli": "ts-node src/cli.ts",
		"start:stdio": "ts-node src/cli.ts",
		"prepack": "npm run build",
		"lint": "eslint --ext .ts src",
		"lint:fix": "eslint --ext .ts src --fix",
		"format": "prettier --write \"src/**/*.{ts,js,json}\" \"test/**/*.ts\" \"*.md\"",
		"format:check": "prettier --check \"src/**/*.{ts,js,json}\" \"test/**/*.ts\" \"*.md\""
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CRACKISH/mcp-creatio.git"
	},
	"keywords": [
		"mcp",
		"model-context-protocol",
		"creatio",
		"creatio-crm",
		"crm",
		"odata",
		"mcp-server",
		"chatgpt",
		"claude",
		"github-copilot",
		"typescript",
		"ai-tools"
	],
	"author": "",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/CRACKISH/mcp-creatio/issues"
	},
	"homepage": "https://github.com/CRACKISH/mcp-creatio#readme",
	"description": "MCP server for Creatio CRM. Connect Claude Desktop, ChatGPT, and GitHub Copilot to Creatio via Model Context Protocol and OData v4.",
	"devDependencies": {
		"@types/express": "5.0.6",
		"@types/node": "^26.6.5",
		"@types/supertest": "^7.2.1",
		"@typescript-eslint/eslint-plugin": "^8.71.2",
		"@typescript-eslint/parser": "^8.71.2",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-prettier": "^5.5.7",
		"prettier": "^3.9.10",
		"rimraf": "^6.1.3",
		"supertest": "^7.3.1",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.1",
		"@types/jsonwebtoken": "^9.0.10",
		"express": "^5.3.0",
		"fast-xml-parser": "^5.11.2",
		"jsonwebtoken": "^9.0.3",
		"redis": "^6.3.0",
		"undici": "^6.29.1",
		"zod": "^4.6.7"
	}
}
